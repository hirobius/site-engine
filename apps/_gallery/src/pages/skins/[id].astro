---
import "../../styles/global.css";
import Document from "@hirobius/template/components/Document.astro";
import Hero from "@hirobius/template/components/Hero.astro";
import ServicesGrid from "@hirobius/template/components/ServicesGrid.astro";
import Gallery from "@hirobius/template/components/Gallery.astro";
import Reviews from "@hirobius/template/components/Reviews.astro";
import ServiceAreaMap from "@hirobius/template/components/ServiceAreaMap.astro";
import ContactForm from "@hirobius/template/components/ContactForm.astro";
import Footer from "@hirobius/template/components/Footer.astro";
import { SKIN_IDS, type SectionId, type SkinId } from "@hirobius/schema";
import { withDesignSkin } from "../../fixtures.js";

// Full-page render of one skin, themed on <html> exactly like a real client
// site (Document.astro) — palette, web fonts, type scale and density all
// resolve the way they would in production. The /skins overview frames these
// pages; a scoped wrapper div can't stand in for them, because Tailwind
// resolves its --color-*/--font-* theme vars once at :root.
export function getStaticPaths() {
  return SKIN_IDS.map((id) => ({ params: { id } }));
}

const config = withDesignSkin(Astro.params.id as SkinId);
const SECTIONS: Record<SectionId, typeof ServicesGrid> = {
  services: ServicesGrid,
  gallery: Gallery,
  reviews: Reviews,
  serviceAreaMap: ServiceAreaMap,
  contact: ContactForm,
};
---

<Document config={config} noindex>
  <main id="main-content">
    <Hero config={config} />
    {
      config.layout.sectionOrder.map((id) => {
        const Section = SECTIONS[id];
        return <Section config={config} />;
      })
    }
  </main>
  <Footer config={config} />
</Document>
