{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "VERCEL_ENV",
    "SITE_LIVE",
    "PREVIEW_USER",
    "PREVIEW_PASS",
    "PREVIEW_TOKEN",
    "PREVIEW_BUILD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vercel/output/**"],
      "env": ["PUBLIC_*"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "@hirobius/scripts#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/SECRETS.md",
        "$TURBO_ROOT$/status.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/client.config.ts",
        "$TURBO_ROOT$/apps/*/site-spec.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
