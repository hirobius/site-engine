{
  "name": "hirobius-clients",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for mass-producing one-page marketing sites for local service businesses.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "test": "pnpm state:check && turbo run test",
    "lint": "turbo run check",
    "ralph:kit-drift": "node scripts/check-ralph-kit-drift.mjs",
    "new-client": "tsx scripts/new-client.ts",
    "eject-client": "tsx scripts/eject-client.ts",
    "deploy-preview": "tsx scripts/deploy-preview.ts",
    "render-site": "tsx scripts/render-site.ts",
    "go-live": "tsx scripts/go-live.ts",
    "verify-live": "tsx scripts/verify-live.ts",
    "skin-critique": "tsx scripts/skin-critique.ts",
    "inspiration:capture": "tsx scripts/inspiration-capture.ts",
    "schema:snapshot-ops": "tsx packages/schema/scripts/refresh-ops-snapshot.ts",
    "template:snapshot-hds": "tsx packages/template/scripts/refresh-hds-contract.ts",
    "state:generate": "tsx scripts/generate-front-door.ts",
    "state:check": "tsx scripts/generate-front-door.ts --check && tsx scripts/check-state-surfaces.ts && tsx scripts/check-steering-budget.ts",
    "state:review": "tsx scripts/check-state-surfaces.ts --strict-review"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
